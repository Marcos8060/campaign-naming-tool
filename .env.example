# Database
DB_PASSWORD=dev_password_123
DB_PORT=5432

# Backend
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-please-change-in-production
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# pgAdmin
PGADMIN_PORT=5050

# Email — Gmail SMTP
# Generate an App Password at: myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_16_char_app_password
EMAIL_FROM=your@gmail.com

# OAuth callback base — must be reachable by a browser redirect from Meta.
# localhost is fine for local dev; production needs a public HTTPS URL.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Encrypts stored platform OAuth tokens at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/rotating this key permanently breaks every already-connected ad account.
ENCRYPTION_KEY=

# Meta (Facebook/Instagram) Marketing API — create an app at developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
