# ── Production environment ────────────────────────────────────────────────
# On the server: `cp .env.production.example .env`, then fill in every
# value below with the real thing. Never commit the actual `.env` file —
# it's already gitignored.

# Database — generate a long random password, e.g.:
#   openssl rand -base64 24
DB_PASSWORD=

# Signs/verifies session JWTs. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Encrypts stored platform OAuth tokens at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/rotating this key permanently breaks every already-connected ad
# account — back it up somewhere safe once generated.
ENCRYPTION_KEY=

# Your real domain, HTTPS, no trailing slash. ALLOWED_ORIGINS can be a
# comma-separated list if you ever serve the frontend from more than one
# origin (e.g. with and without "www").
ALLOWED_ORIGINS=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Required whenever the frontend and API are on different (sub)domains,
# e.g. yourdomain.com (frontend) and api.yourdomain.com (backend) — this is
# almost certainly your setup if NEXT_PUBLIC_API_URL above points to an
# "api." subdomain. Must be the shared parent domain with a leading dot so
# cookies set by the API are readable by frontend JS (needed for CSRF —
# see backend/src/config.py). If frontend and API instead share the exact
# same host, leave this blank.
COOKIE_DOMAIN=.yourdomain.com

# Email — Gmail SMTP. Leave blank to disable email sending (password
# reset / invite emails will just log a warning instead of failing).
# Generate an App Password at: myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Meta (Facebook/Instagram) Marketing API — optional, only needed once
# you connect a real ad account. Create an app at developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0

# Base URL the backend uses to build its own OAuth callback link
# (becomes {this}/api/v1/integrations/meta/callback). If left unset, it
# falls back to FRONTEND_URL — which is WRONG whenever the frontend and API
# are on different (sub)domains, since the callback route only exists on
# the API. Set this explicitly to your API's origin (no /api/v1 suffix):
OAUTH_REDIRECT_BASE_URL=https://api.yourdomain.com
# Also required on Meta's side: in your Meta App dashboard, add your domain
# to Settings → Basic → App Domains, and add the full callback URL above to
# Facebook Login → Settings → Valid OAuth Redirect URIs.
